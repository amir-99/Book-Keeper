# PostgreSQL administrator and application-role passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-value
LETTA_DB_PASSWORD=replace-with-a-different-long-random-value
OPENWEBUI_DB_PASSWORD=replace-with-a-different-long-random-value

# External OpenAI-compatible gateway used by Letta and Open WebUI embeddings.
# It must expose the openai/text-embedding-3-small model.
LITELLM_BASE_URL=https://your-litellm.example/v1
LITELLM_API_KEY=replace-with-your-gateway-key

# Letta API authentication and provider-secret encryption.
LETTA_API_KEY=replace-with-a-long-random-value
LETTA_ENCRYPTION_KEY=replace-with-a-long-stable-random-value

# Remote MCP servers registered by letta-assets/bootstrap.
# Keep the real credential-bearing URL in .env only.
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=replace-with-your-tavily-key

# Confluence REST tools registered by letta-assets/bootstrap. Use the site root,
# including a context path when applicable. auto treats user:token credentials
# as Basic auth and opaque personal access tokens as Bearer auth.
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_ACCESS_TOKEN=replace-with-your-confluence-access-token
# CONFLUENCE_AUTH_MODE=auto

# Jira REST tools registered by letta-assets/bootstrap. Use the Jira site root,
# including a context path when applicable. Supported authentication modes are
# bearer, basic (raw user:token), and basic_encoded (an already Base64-encoded
# Basic credential). Keep the real credential only in .env.
JIRA_BASE_URL=https://jira.example.com
JIRA_ACCESS_TOKEN=replace-with-your-jira-access-token
# JIRA_AUTH_MODE=bearer

# Stable Open WebUI session-signing secret.
WEBUI_SECRET_KEY=replace-with-a-long-stable-random-value

# Safe defaults bind the UIs to localhost. Override for trusted LAN access.
# LETTA_BIND_ADDRESS=0.0.0.0
# OPENWEBUI_BIND_ADDRESS=0.0.0.0
# OPENWEBUI_ORIGIN=http://your-trusted-host:3000

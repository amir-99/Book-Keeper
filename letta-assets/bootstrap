#!/usr/bin/env python3
"""Idempotently register declarative assets with a Letta server."""

from __future__ import annotations

import argparse
import ast
import json
import os
import re
import sys
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlsplit
from urllib.request import Request, urlopen


ASSET_DIR = Path(__file__).resolve().parent
REPO_DIR = ASSET_DIR.parent
ENV_REFERENCE = re.compile(r"^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$")
SENSITIVE_NAME = re.compile(r"(?:KEY|TOKEN|PASSWORD|SECRET|CREDENTIAL|URL)$", re.I)
MEMORY_TOOL_TYPES = {
    "letta_memory_core",
    "letta_sleeptime_core",
    "letta_voice_sleeptime_core",
}
MULTI_AGENT_TOOL_TYPE = "letta_multi_agent_core"
AGENT_FIELDS = {
    "agent_type",
    "asset_type",
    "custom_tools",
    "description",
    "embedding",
    "include_base_tools",
    "include_multi_agent_tools",
    "message_buffer_autoclear",
    "mcp_tools",
    "memory_blocks",
    "model",
    "model_settings",
    "name",
    "system",
    "tags",
}
BLOCK_FIELDS = {
    "description",
    "hidden",
    "label",
    "limit",
    "metadata",
    "preserve_existing",
    "read_only",
    "tags",
    "value",
}


class BootstrapError(RuntimeError):
    """An operator-facing bootstrap failure."""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Register the assets in this directory with Letta."
    )
    parser.add_argument(
        "--base-url",
        help="Letta API base URL (default: LETTA_BASE_URL or http://127.0.0.1:8283)",
    )
    parser.add_argument(
        "--env-file",
        type=Path,
        default=REPO_DIR / ".env",
        help="environment file containing Letta and asset secrets",
    )
    return parser.parse_args()


def load_env_file(path: Path) -> dict[str, str]:
    """Load a simple dotenv file without executing it as shell code."""
    if not path.is_file():
        raise BootstrapError(f"environment file not found: {path}")

    values: dict[str, str] = {}
    for line_number, raw_line in enumerate(path.read_text().splitlines(), start=1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            raise BootstrapError(f"invalid environment entry at {path}:{line_number}")
        name, value = line.split("=", 1)
        name = name.strip()
        value = value.strip()
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise BootstrapError(f"invalid environment name at {path}:{line_number}")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        values[name] = value
    return values


def resolve_value(value: Any, environment: dict[str, str], source: Path) -> Any:
    if isinstance(value, str):
        match = ENV_REFERENCE.fullmatch(value)
        if not match:
            return value
        name = match.group(1)
        resolved = environment.get(name)
        if not resolved:
            raise BootstrapError(f"{source}: required environment variable {name} is unset")
        return resolved
    if isinstance(value, list):
        return [resolve_value(item, environment, source) for item in value]
    if isinstance(value, dict):
        return {key: resolve_value(item, environment, source) for key, item in value.items()}
    return value


def load_assets(
    environment: dict[str, str],
) -> tuple[
    list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]
]:
    mcp_assets: list[dict[str, Any]] = []
    for path in sorted((ASSET_DIR / "mcp-servers").glob("*.json")):
        try:
            raw_asset = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise BootstrapError(f"cannot read {path}: {exc}") from exc

        asset = resolve_value(raw_asset, environment, path)
        if not isinstance(asset, dict) or asset.get("asset_type") != "mcp_server":
            raise BootstrapError(f"{path}: expected asset_type=mcp_server")
        if not isinstance(asset.get("server_name"), str) or not asset["server_name"]:
            raise BootstrapError(f"{path}: server_name must be a non-empty string")
        config = asset.get("config")
        if not isinstance(config, dict):
            raise BootstrapError(f"{path}: config must be an object")
        if config.get("mcp_server_type") not in {"streamable_http", "sse", "stdio"}:
            raise BootstrapError(f"{path}: unsupported mcp_server_type")
        if config.get("mcp_server_type") in {"streamable_http", "sse"}:
            server_url = config.get("server_url")
            if not isinstance(server_url, str) or urlsplit(server_url).scheme not in {"http", "https"}:
                raise BootstrapError(f"{path}: server_url must be an HTTP(S) URL")
        asset["_source"] = path
        mcp_assets.append(asset)

    tool_assets: list[dict[str, Any]] = []
    for path in sorted((ASSET_DIR / "tools").glob("*.py")):
        try:
            source_code = path.read_text()
            syntax_tree = ast.parse(source_code, filename=str(path))
        except (OSError, SyntaxError) as exc:
            raise BootstrapError(f"cannot read {path}: {exc}") from exc
        functions = [
            node
            for node in syntax_tree.body
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        ]
        if len(functions) != 1:
            raise BootstrapError(
                f"{path}: expected exactly one top-level tool function"
            )
        tool_assets.append(
            {
                "name": functions[0].name,
                "source_code": source_code,
                "source_type": "python",
                "tags": ["letta-assets"],
                "_source": path,
            }
        )

    agent_assets: list[dict[str, Any]] = []
    for path in sorted((ASSET_DIR / "agents").glob("*.json")):
        try:
            raw_asset = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise BootstrapError(f"cannot read {path}: {exc}") from exc

        asset = resolve_value(raw_asset, environment, path)
        if not isinstance(asset, dict) or asset.get("asset_type") != "agent":
            raise BootstrapError(f"{path}: expected asset_type=agent")
        unknown_fields = sorted(set(asset) - AGENT_FIELDS)
        if unknown_fields:
            raise BootstrapError(f"{path}: unsupported field(s): {', '.join(unknown_fields)}")
        for field in ("name", "system"):
            if not isinstance(asset.get(field), str) or not asset[field].strip():
                raise BootstrapError(f"{path}: {field} must be a non-empty string")
        for field in (
            "include_base_tools",
            "include_multi_agent_tools",
            "message_buffer_autoclear",
        ):
            if field in asset and not isinstance(asset[field], bool):
                raise BootstrapError(f"{path}: {field} must be a boolean")

        tags = asset.get("tags", [])
        if (
            not isinstance(tags, list)
            or any(not isinstance(tag, str) or not tag for tag in tags)
            or len(tags) != len(set(tags))
        ):
            raise BootstrapError(f"{path}: tags must be a unique array of non-empty strings")

        model_settings = asset.get("model_settings")
        if model_settings is not None:
            if not isinstance(model_settings, dict):
                raise BootstrapError(f"{path}: model_settings must be an object")
            provider_type = model_settings.get("provider_type")
            if not isinstance(provider_type, str) or not provider_type:
                raise BootstrapError(
                    f"{path}: model_settings.provider_type must be a non-empty string"
                )

        custom_tools = asset.get("custom_tools", [])
        if (
            not isinstance(custom_tools, list)
            or any(not isinstance(name, str) or not name for name in custom_tools)
            or len(custom_tools) != len(set(custom_tools))
        ):
            raise BootstrapError(
                f"{path}: custom_tools must be a unique array of non-empty strings"
            )

        memory_blocks = asset.get("memory_blocks", [])
        if not isinstance(memory_blocks, list) or not memory_blocks:
            raise BootstrapError(f"{path}: memory_blocks must be a non-empty array")
        block_labels: set[str] = set()
        for block in memory_blocks:
            if not isinstance(block, dict):
                raise BootstrapError(f"{path}: each memory block must be an object")
            unknown_block_fields = sorted(set(block) - BLOCK_FIELDS)
            if unknown_block_fields:
                raise BootstrapError(
                    f"{path}: unsupported memory block field(s): "
                    f"{', '.join(unknown_block_fields)}"
                )
            for field in ("label", "value"):
                if not isinstance(block.get(field), str) or not block[field].strip():
                    raise BootstrapError(
                        f"{path}: memory block {field} must be a non-empty string"
                    )
            if block["label"] in block_labels:
                raise BootstrapError(
                    f"{path}: duplicate memory block label {block['label']!r}"
                )
            block_labels.add(block["label"])
            if "preserve_existing" in block and not isinstance(
                block["preserve_existing"], bool
            ):
                raise BootstrapError(
                    f"{path}: preserve_existing must be a boolean"
                )

        mcp_tools = asset.get("mcp_tools", [])
        if not isinstance(mcp_tools, list):
            raise BootstrapError(f"{path}: mcp_tools must be an array")
        for tool_group in mcp_tools:
            if not isinstance(tool_group, dict):
                raise BootstrapError(f"{path}: each mcp_tools entry must be an object")
            if set(tool_group) != {"server_name", "tool_names"}:
                raise BootstrapError(
                    f"{path}: each mcp_tools entry requires only server_name and tool_names"
                )
            server_name = tool_group["server_name"]
            tool_names = tool_group["tool_names"]
            if not isinstance(server_name, str) or not server_name:
                raise BootstrapError(f"{path}: MCP server_name must be a non-empty string")
            if (
                not isinstance(tool_names, list)
                or not tool_names
                or any(not isinstance(name, str) or not name for name in tool_names)
            ):
                raise BootstrapError(
                    f"{path}: MCP tool_names must be a non-empty array of strings"
                )
            if len(tool_names) != len(set(tool_names)):
                raise BootstrapError(
                    f"{path}: duplicate tool name in MCP server {server_name!r}"
                )

        asset["_source"] = path
        agent_assets.append(asset)

    if not mcp_assets and not tool_assets and not agent_assets:
        raise BootstrapError(f"no assets found under {ASSET_DIR}")

    duplicate_mcp_names = _duplicates(asset["server_name"] for asset in mcp_assets)
    if duplicate_mcp_names:
        raise BootstrapError(f"duplicate MCP server asset(s): {', '.join(duplicate_mcp_names)}")
    duplicate_tool_names = _duplicates(asset["name"] for asset in tool_assets)
    if duplicate_tool_names:
        raise BootstrapError(
            f"duplicate custom tool asset(s): {', '.join(duplicate_tool_names)}"
        )
    duplicate_agent_names = _duplicates(asset["name"] for asset in agent_assets)
    if duplicate_agent_names:
        raise BootstrapError(f"duplicate agent asset(s): {', '.join(duplicate_agent_names)}")
    return mcp_assets, tool_assets, agent_assets


def _duplicates(values: Any) -> list[str]:
    seen: set[str] = set()
    duplicates: set[str] = set()
    for value in values:
        if value in seen:
            duplicates.add(value)
        seen.add(value)
    return sorted(duplicates)


def response_items(payload: Any) -> list[dict[str, Any]]:
    if isinstance(payload, list):
        return [item for item in payload if isinstance(item, dict)]
    if isinstance(payload, dict):
        for key in (
            "data",
            "agents",
            "blocks",
            "mcp_servers",
            "models",
            "servers",
            "tools",
        ):
            value = payload.get(key)
            if isinstance(value, list):
                return [item for item in value if isinstance(item, dict)]
    return []


def validate_agent_model_handles(
    api: "LettaApi", agent_assets: list[dict[str, Any]]
) -> None:
    model_handles = {
        model["handle"]
        for model in response_items(api.request("GET", "/v1/models/"))
        if isinstance(model.get("handle"), str)
    }
    embedding_handles = {
        model["handle"]
        for model in response_items(api.request("GET", "/v1/models/embedding"))
        if isinstance(model.get("handle"), str)
    }

    for asset in agent_assets:
        source = asset["_source"]
        model = asset.get("model")
        if model is not None and model not in model_handles:
            raise BootstrapError(f"{source}: model handle {model!r} is not registered")
        embedding = asset.get("embedding")
        if embedding is not None and embedding not in embedding_handles:
            raise BootstrapError(
                f"{source}: embedding handle {embedding!r} is not registered"
            )


def multi_agent_tools(api: "LettaApi") -> list[dict[str, Any]]:
    tools = response_items(api.request("GET", "/v1/tools/?limit=200"))
    return [tool for tool in tools if tool.get("tool_type") == MULTI_AGENT_TOOL_TYPE]


class LettaApi:
    def __init__(self, base_url: str, api_key: str, secrets: list[str]) -> None:
        self.base_url = base_url.rstrip("/")
        self.api_key = api_key
        self.secrets = sorted((secret for secret in secrets if secret), key=len, reverse=True)

    def redact(self, text: str) -> str:
        for secret in self.secrets:
            text = text.replace(secret, "[REDACTED]")
        return text

    def request(self, method: str, path: str, payload: Any | None = None) -> Any:
        body = None if payload is None else json.dumps(payload).encode()
        request = Request(
            f"{self.base_url}/{path.lstrip('/')}",
            data=body,
            method=method,
            headers={
                "Accept": "application/json",
                "Authorization": f"Bearer {self.api_key}",
                "Content-Type": "application/json",
                "User-Agent": "letta-assets-bootstrap/1.0",
            },
        )
        try:
            with urlopen(request, timeout=60) as response:
                raw_body = response.read()
        except HTTPError as exc:
            details = exc.read().decode(errors="replace").strip()
            message = f"Letta API returned HTTP {exc.code} for {method} {path}"
            if details:
                message += f": {details}"
            raise BootstrapError(self.redact(message)) from exc
        except URLError as exc:
            reason = self.redact(str(exc.reason))
            raise BootstrapError(
                f"cannot reach Letta at {self.base_url}: {reason}; start it with docker compose up -d"
            ) from exc

        if not raw_body:
            return None
        try:
            return json.loads(raw_body)
        except json.JSONDecodeError as exc:
            raise BootstrapError(f"Letta returned invalid JSON for {method} {path}") from exc


def sync_mcp_server(
    api: LettaApi, asset: dict[str, Any], existing: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    server_name = asset["server_name"]
    matches = [server for server in existing if server.get("server_name") == server_name]
    if len(matches) > 1:
        raise BootstrapError(f"multiple Letta MCP servers are named {server_name!r}")

    payload = {"server_name": server_name, "config": asset["config"]}
    if matches:
        server_id = matches[0].get("id")
        if not isinstance(server_id, str) or not server_id:
            raise BootstrapError(f"existing MCP server {server_name!r} has no id")
        api.request("PATCH", f"/v1/mcp-servers/{quote(server_id, safe='')}", payload)
        action = "updated"
    else:
        created = api.request("POST", "/v1/mcp-servers/", payload)
        server_id = created.get("id") if isinstance(created, dict) else None
        if not isinstance(server_id, str) or not server_id:
            raise BootstrapError(f"Letta did not return an id for MCP server {server_name!r}")
        action = "created"

    encoded_id = quote(server_id, safe="")
    api.request("PATCH", f"/v1/mcp-servers/{encoded_id}/refresh", {})
    tools_payload = api.request("GET", f"/v1/mcp-servers/{encoded_id}/tools")
    tools = response_items(tools_payload)
    tool_names = sorted(
        tool["name"] for tool in tools if isinstance(tool.get("name"), str)
    )
    print(f"{server_name}: {action}; synchronized {len(tool_names)} tool(s)")
    for name in tool_names:
        print(f"  - {name}")
    return tools


def sync_custom_tool(
    api: LettaApi, asset: dict[str, Any], existing: list[dict[str, Any]]
) -> dict[str, Any]:
    name = asset["name"]
    matches = [tool for tool in existing if tool.get("name") == name]
    if len(matches) > 1:
        raise BootstrapError(f"multiple Letta custom tools are named {name!r}")

    payload = {
        key: asset[key]
        for key in ("source_code", "source_type", "tags")
    }
    synchronized = api.request("PUT", "/v1/tools/", payload)
    tool_id = synchronized.get("id") if isinstance(synchronized, dict) else None
    if not isinstance(tool_id, str) or not tool_id:
        raise BootstrapError(f"Letta did not return an id for custom tool {name!r}")
    synchronized_name = (
        synchronized.get("name") if isinstance(synchronized, dict) else None
    )
    if synchronized_name != name:
        raise BootstrapError(
            f"Letta registered custom tool {synchronized_name!r}, expected {name!r}"
        )
    print(f"{name}: {'updated' if matches else 'created'} custom tool")
    return synchronized


def block_payload(block: dict[str, Any], *, include_value: bool) -> dict[str, Any]:
    payload = {
        key: value
        for key, value in block.items()
        if key != "preserve_existing" and (include_value or key != "value")
    }
    return payload


def attached_agent_tools(api: LettaApi, agent_id: str) -> list[dict[str, Any]]:
    agent = api.request("GET", f"/v1/agents/{quote(agent_id, safe='')}")
    if isinstance(agent, dict) and isinstance(agent.get("tools"), list):
        return [tool for tool in agent["tools"] if isinstance(tool, dict)]
    return response_items(
        api.request("GET", f"/v1/agents/{quote(agent_id, safe='')}/tools")
    )


def sync_memory_blocks(
    api: LettaApi, agent_id: str, memory_blocks: list[dict[str, Any]]
) -> None:
    encoded_agent_id = quote(agent_id, safe="")
    existing = response_items(
        api.request("GET", f"/v1/agents/{encoded_agent_id}/core-memory/blocks")
    )
    for block in memory_blocks:
        label = block["label"]
        matches = [item for item in existing if item.get("label") == label]
        if len(matches) > 1:
            raise BootstrapError(
                f"agent {agent_id!r} has multiple memory blocks labeled {label!r}"
            )
        if matches:
            preserve = block.get("preserve_existing", True)
            api.request(
                "PATCH",
                f"/v1/agents/{encoded_agent_id}/core-memory/blocks/"
                f"{quote(label, safe='')}",
                block_payload(block, include_value=not preserve),
            )
            continue

        created = api.request(
            "POST", "/v1/blocks/", block_payload(block, include_value=True)
        )
        block_id = created.get("id") if isinstance(created, dict) else None
        if not isinstance(block_id, str) or not block_id:
            raise BootstrapError(
                f"Letta did not return an id for memory block {label!r}"
            )
        api.request(
            "PATCH",
            f"/v1/agents/{encoded_agent_id}/core-memory/blocks/attach/"
            f"{quote(block_id, safe='')}",
            {},
        )


def resolve_agent_tools(
    asset: dict[str, Any],
    mcp_tools_by_server: dict[str, list[dict[str, Any]]],
) -> list[dict[str, Any]]:
    desired: dict[str, dict[str, Any]] = {}
    for tool_group in asset.get("mcp_tools", []):
        server_name = tool_group["server_name"]
        server_tools = mcp_tools_by_server.get(server_name)
        if server_tools is None:
            source = asset["_source"]
            raise BootstrapError(
                f"{source}: MCP server {server_name!r} is not declared or synchronized"
            )
        tools_by_name = {
            tool.get("name"): tool
            for tool in server_tools
            if isinstance(tool.get("name"), str)
        }
        for tool_name in tool_group["tool_names"]:
            tool = tools_by_name.get(tool_name)
            tool_id = tool.get("id") if isinstance(tool, dict) else None
            if not isinstance(tool_id, str) or not tool_id:
                source = asset["_source"]
                raise BootstrapError(
                    f"{source}: MCP server {server_name!r} has no tool {tool_name!r}"
                )
            desired[tool_id] = tool
    return list(desired.values())


def resolve_custom_tools(
    asset: dict[str, Any], custom_tools_by_name: dict[str, dict[str, Any]]
) -> list[dict[str, Any]]:
    desired: list[dict[str, Any]] = []
    for name in asset.get("custom_tools", []):
        tool = custom_tools_by_name.get(name)
        tool_id = tool.get("id") if isinstance(tool, dict) else None
        if not isinstance(tool_id, str) or not tool_id:
            source = asset["_source"]
            raise BootstrapError(
                f"{source}: custom tool {name!r} is not declared or synchronized"
            )
        desired.append(tool)
    return desired


def sync_agent(
    api: LettaApi,
    asset: dict[str, Any],
    existing: list[dict[str, Any]],
    mcp_tools_by_server: dict[str, list[dict[str, Any]]],
    custom_tools_by_name: dict[str, dict[str, Any]],
    available_multi_agent_tools: list[dict[str, Any]],
) -> None:
    name = asset["name"]
    matches = [agent for agent in existing if agent.get("name") == name]
    if len(matches) > 1:
        raise BootstrapError(f"multiple Letta agents are named {name!r}")

    desired_mcp_tools = resolve_agent_tools(asset, mcp_tools_by_server)
    desired_custom_tools = resolve_custom_tools(asset, custom_tools_by_name)
    desired_multi_agent_tools = (
        available_multi_agent_tools
        if asset.get("include_multi_agent_tools", False)
        else []
    )
    if asset.get("include_multi_agent_tools", False) and not desired_multi_agent_tools:
        raise BootstrapError(f"Letta has no {MULTI_AGENT_TOOL_TYPE!r} tools registered")

    desired_create_tool_ids = sorted(
        {
            tool["id"]
            for tool in [*desired_mcp_tools, *desired_custom_tools]
            if isinstance(tool.get("id"), str)
        }
    )
    desired_tool_ids = sorted(
        {
            tool["id"]
            for tool in [
                *desired_mcp_tools,
                *desired_custom_tools,
                *desired_multi_agent_tools,
            ]
            if isinstance(tool.get("id"), str)
        }
    )
    common_fields = {
        key: asset[key]
        for key in (
            "description",
            "embedding",
            "message_buffer_autoclear",
            "model",
            "model_settings",
            "system",
            "tags",
        )
        if key in asset
    }

    if matches:
        agent_id = matches[0].get("id")
        if not isinstance(agent_id, str) or not agent_id:
            raise BootstrapError(f"existing agent {name!r} has no id")
        api.request(
            "PATCH", f"/v1/agents/{quote(agent_id, safe='')}", common_fields
        )
        action = "updated"
    else:
        create_payload = {
            "name": name,
            **common_fields,
            "include_base_tools": asset.get("include_base_tools", True),
            "include_multi_agent_tools": asset.get("include_multi_agent_tools", False),
            "memory_blocks": [
                block_payload(block, include_value=True)
                for block in asset["memory_blocks"]
            ],
            "tool_ids": desired_create_tool_ids,
        }
        if "agent_type" in asset:
            create_payload["agent_type"] = asset["agent_type"]
        created = api.request("POST", "/v1/agents/", create_payload)
        agent_id = created.get("id") if isinstance(created, dict) else None
        if not isinstance(agent_id, str) or not agent_id:
            raise BootstrapError(f"Letta did not return an id for agent {name!r}")
        action = "created"

    sync_memory_blocks(api, agent_id, asset["memory_blocks"])

    encoded_agent_id = quote(agent_id, safe="")
    attached_tools = attached_agent_tools(api, agent_id)
    attached_ids = {
        tool["id"]
        for tool in attached_tools
        if isinstance(tool.get("id"), str)
    }
    for tool_id in desired_tool_ids:
        if tool_id not in attached_ids:
            api.request(
                "PATCH",
                f"/v1/agents/{encoded_agent_id}/tools/attach/"
                f"{quote(tool_id, safe='')}",
                {},
            )

    attached_tools = attached_agent_tools(api, agent_id)
    attached_ids = {
        tool["id"]
        for tool in attached_tools
        if isinstance(tool.get("id"), str)
    }
    missing_ids = set(desired_tool_ids) - attached_ids
    if missing_ids:
        raise BootstrapError(f"agent {name!r} is missing {len(missing_ids)} requested tool(s)")

    memory_tool_names = sorted(
        tool["name"]
        for tool in attached_tools
        if tool.get("tool_type") in MEMORY_TOOL_TYPES
        and isinstance(tool.get("name"), str)
    )
    if asset.get("include_base_tools", True) and not memory_tool_names:
        raise BootstrapError(f"agent {name!r} has no attached base memory tools")

    mcp_tool_names = sorted(
        tool["name"]
        for tool in desired_mcp_tools
        if tool.get("tool_type") == "external_mcp"
        and isinstance(tool.get("name"), str)
    )
    custom_tool_names = sorted(
        tool["name"]
        for tool in desired_custom_tools
        if isinstance(tool.get("name"), str)
    )
    multi_agent_tool_names = sorted(
        tool["name"]
        for tool in desired_multi_agent_tools
        if isinstance(tool.get("name"), str)
    )
    print(
        f"{name}: {action}; synchronized {len(asset['memory_blocks'])} memory "
        f"block(s), {len(memory_tool_names)} base memory tool(s), and "
        f"{len(mcp_tool_names)} MCP tool(s), "
        f"{len(custom_tool_names)} custom tool(s), and "
        f"{len(multi_agent_tool_names)} multi-agent tool(s)"
    )
    for tool_name in [
        *mcp_tool_names,
        *custom_tool_names,
        *multi_agent_tool_names,
    ]:
        print(f"  - {tool_name}")


def main() -> int:
    args = parse_args()
    file_environment = load_env_file(args.env_file.resolve())
    environment = {**file_environment, **os.environ}

    base_url = args.base_url or environment.get("LETTA_BASE_URL", "http://127.0.0.1:8283")
    if urlsplit(base_url).scheme not in {"http", "https"}:
        raise BootstrapError("LETTA_BASE_URL must be an HTTP(S) URL")
    api_key = environment.get("LETTA_API_KEY")
    if not api_key:
        raise BootstrapError("LETTA_API_KEY is unset")

    mcp_assets, tool_assets, agent_assets = load_assets(environment)
    secrets = [
        value
        for name, value in environment.items()
        if value and SENSITIVE_NAME.search(name)
    ]
    api = LettaApi(base_url, api_key, secrets)
    validate_agent_model_handles(api, agent_assets)
    existing_mcp_servers = response_items(api.request("GET", "/v1/mcp-servers/"))
    mcp_tools_by_server: dict[str, list[dict[str, Any]]] = {}

    for asset in mcp_assets:
        mcp_tools_by_server[asset["server_name"]] = sync_mcp_server(
            api, asset, existing_mcp_servers
        )

    existing_tools = response_items(api.request("GET", "/v1/tools/?limit=200"))
    custom_tools_by_name: dict[str, dict[str, Any]] = {}
    for asset in tool_assets:
        synchronized = sync_custom_tool(api, asset, existing_tools)
        custom_tools_by_name[asset["name"]] = synchronized

    if agent_assets:
        existing_agents = response_items(api.request("GET", "/v1/agents/?limit=1000"))
        available_multi_agent_tools = multi_agent_tools(api)
        for asset in agent_assets:
            sync_agent(
                api,
                asset,
                existing_agents,
                mcp_tools_by_server,
                custom_tools_by_name,
                available_multi_agent_tools,
            )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BootstrapError as exc:
        print(f"bootstrap: error: {exc}", file=sys.stderr)
        raise SystemExit(1)
